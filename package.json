{
  "name": "escan-dni-peru",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de Escaneo de Identidad Peruana y Generación de Contratos",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "node dev.js",
    "dev:share": "node dev.js --share",
    "start": "node dev.js",
    "share": "cd frontend && node start_tunnel.cjs",
    "share:cf": "npx -y cloudflared tunnel --url http://localhost:5173",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "python -m uvicorn backend.main:app --reload --host 0.0.0.0 --port 8000",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "backend": "python -m uvicorn backend.main:app --reload --host 0.0.0.0 --port 8000"
  }
}
